    "\n",
    "image_size = 256\n",
    "device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
    "\n",
    "\n",
    "def center_mask(batch, hole=128):\n",
    "    top = (image_size - hole) // 2\n",
    "    left = (image_size - hole) // 2\n",
    "    mask = torch.ones(batch, 1, image_size, image_size, device=device)\n",
    "    mask[:, :, top:top + hole, left:left + hole] = 0.0\n",
    "    return mask\n",
    "\n",
    "\n",
    "class PyramidProbEncoder(nn.Module):\n",
    "    def __init__(self, channels=(64, 128, 256)):\n",
    "        super().__init__()\n",
    "        self.blocks = nn.ModuleList()\n",
    "        in_ch = 3\n",
    "        for ch in channels:\n",
    "            self.blocks.append(nn.Sequential(\n",
    "                nn.Conv2d(in_ch, ch, 4, 2, 1),\n",
    "                nn.LeakyReLU(0.2, inplace=True)\n",
    "            ))\n",
    "            in_ch = ch\n",
    "        self.mu = nn.ModuleList([nn.Conv2d(c, c, 3, 1, 1) for c in channels])\n",
    "        self.logvar = nn.ModuleList([nn.Conv2d(c, c, 3, 1, 1) for c in channels])\n",
    "\n",
    "    def forward(self, x):\n",
    "        feats, mus, logvars = [], [], []\n",
    "        for block, mu, logvar in zip(self.blocks, self.mu, self.logvar):\n",
    "            x = block(x)\n",
    "            feats.append(x)\n",
    "            mus.append(mu(x))\n",
    "            logvars.append(logvar(x))\n",
    "        return feats, mus, logvars\n",
    "\n",
    "\n",
    "class Reparam(nn.Module):\n",
    "    def forward(self, mu, logvar):\n",
    "        std = torch.exp(0.5 * logvar)\n",
    "        eps = torch.randn_like(std)\n",
    "        return mu + eps * std\n",
    "\n",
    "\n",
    "class LatentTransfer(nn.Module):\n",
    "    def forward(self, high_z, low_z):\n",
    "        b, c, h, w = high_z.shape\n",
    "        high_flat = high_z.view(b, c, -1)\n",
    "        low_flat = low_z.view(b, c, -1)\n",
    "        sim = torch.bmm(high_flat.transpose(1, 2), low_flat)\n",
    "        denom = high_flat.norm(dim=1, keepdim=True).transpose(1, 2) * low_flat.norm(dim=1, keepdim=True) + 1e-8\n",
    "        attn = F.softmax(sim / denom, dim=1)\n",
    "        fused = torch.bmm(low_flat, attn.transpose(1, 2))\n",
    "        return fused.view(b, c, h, w)\n",
    "\n",
    "\n",
    "class PyramidDecoder(nn.Module):\n",
    "    def __init__(self):\n",
    "        super().__init__()\n",
    "        self.up1 = nn.ConvTranspose2d(256, 128, 4, 2, 1)\n",
    "        self.up2 = nn.ConvTranspose2d(256, 64, 4, 2, 1)\n",
    "        self.up3 = nn.ConvTranspose2d(128, 64, 4, 2, 1)\n",
    "        self.out = nn.Conv2d(64, 3, 3, 1, 1)\n",
    "\n",
    "    def forward(self, z_high, z_mid, z_low):\n",
    "        x = F.relu(self.up1(z_high))\n",
    "        x = torch.cat([x, z_mid], dim=1)\n",
    "        x = F.relu(self.up2(x))\n",
    "        x = torch.cat([x, z_low], dim=1)\n",
    "        x = F.relu(self.up3(x))\n",
    "        return torch.tanh(self.out(x))\n",
    "\n",
    "\n",
    "class PVGGenerator(nn.Module):\n",
    "    def __init__(self):\n",
    "        super().__init__()\n",
    "        self.encoder = PyramidProbEncoder()\n",
    "        self.reparam = Reparam()\n",
    "        self.transfer = LatentTransfer()\n",
    "        self.decoder = PyramidDecoder()\n",
    "\n",
    "    def forward(self, x):\n",
    "        feats, mus, logvars = self.encoder(x)\n",
    "        z_high = self.reparam(mus[2], logvars[2])\n",
    "        z_mid_raw = self.reparam(mus[1], logvars[1])\n",
    "        z_low_raw = self.reparam(mus[0], logvars[0])\n",
    "        z_mid = self.transfer(z_high, z_mid_raw)\n",
    "        z_low = self.transfer(z_mid, z_low_raw)\n",
    "        out = self.decoder(z_high, z_mid, z_low)\n",
    "        return out, mus, logvars\n",
    "\n",
    "\n",
    "class Discriminator(nn.Module):\n",
    "    def __init__(self):\n",
    "        super().__init__()\n",
    "        ch = 64\n",
    "        self.net = nn.Sequential(\n",
    "            nn.Conv2d(4, ch, 4, 2, 1), nn.LeakyReLU(0.2, inplace=True),\n",
    "            nn.Conv2d(ch, ch * 2, 4, 2, 1), nn.LeakyReLU(0.2, inplace=True),\n",
    "            nn.Conv2d(ch * 2, ch * 4, 4, 2, 1), nn.LeakyReLU(0.2, inplace=True),\n",
    "            nn.Conv2d(ch * 4, ch * 4, 4, 2, 1), nn.LeakyReLU(0.2, inplace=True),\n",
    "            nn.Conv2d(ch * 4, 1, 4, 1, 0)\n",
    "        )\n",
    "\n",
    "    def forward(self, x, mask):\n",
    "        x = torch.cat([x, mask], dim=1)\n",
    "        return self.net(x).view(x.size(0), -1)\n",
    "\n",
    "\n",
    "class ImageFolder(Dataset):\n",
    "    def __init__(self, root):\n",
    "        self.files = [os.path.join(root, f) for f in os.listdir(root) if f.lower().endswith((\".png\", \".jpg\", \".jpeg\"))]\n",
    "        self.t = transforms.Compose([\n",
    "            transforms.Resize((image_size, image_size)),\n",
