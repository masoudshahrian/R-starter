    "        ])\n",
    "\n",
    "    def __len__(self):\n",
    "        return len(self.files)\n",
    "\n",
    "    def __getitem__(self, idx):\n",
    "        img = Image.open(self.files[idx]).convert(\"RGB\")\n",
    "        return self.t(img)\n",
    "\n",
    "\n",
    "def kl_loss(mus, logvars):\n",
    "    total = 0.0\n",
    "    for mu, logvar in zip(mus, logvars):\n",
    "        total += -0.5 * torch.mean(1 + logvar - mu.pow(2) - logvar.exp())\n",
    "    return total\n",
    "\n",
    "\n",
    "def recon_loss(pred, target, mask):\n",
    "    return F.l1_loss(pred * (1 - mask), target * (1 - mask))\n",
    "\n",
    "\n",
    "def hinge_d_loss(real_logits, fake_logits):\n",
    "    return torch.mean(F.relu(1 - real_logits)) + torch.mean(F.relu(1 + fake_logits))\n",
    "\n",
    "\n",
    "def hinge_g_loss(fake_logits):\n",
    "    return -torch.mean(fake_logits)\n",
    "\n",
    "\n",
    "def train_step(netG, netD, imgs, optG, optD):\n",
    "    mask = center_mask(imgs.size(0))\n",
    "    masked = imgs * mask\n",
    "    fake, mus, logvars = netG(masked)\n",
    "    comp = imgs * mask + fake * (1 - mask)\n",
    "    optD.zero_grad()\n",
    "    real_logits = netD(imgs, mask)\n",
    "    fake_logits = netD(comp.detach(), mask)\n",
    "    d_loss = hinge_d_loss(real_logits, fake_logits)\n",
    "    d_loss.backward()\n",
    "    optD.step()\n",
    "    optG.zero_grad()\n",
    "    fake_logits = netD(comp, mask)\n",
    "    g_adv = hinge_g_loss(fake_logits)\n",
    "    g_rec = recon_loss(fake, imgs, mask)\n",
    "    g_kl = kl_loss(mus, logvars)\n",
    "    g_loss = g_adv + g_rec + g_kl\n",
    "    g_loss.backward()\n",
    "    optG.step()\n",
    "    return d_loss.item(), g_loss.item()\n",
    "\n",
    "\n",
    "def train(data_dir, epochs=1, batch_size=4, lr=2e-4):\n",
    "    ds = ImageFolder(data_dir)\n",
    "    loader = DataLoader(ds, batch_size=batch_size, shuffle=True, num_workers=0)\n",
    "    netG = PVGGenerator().to(device)\n",
    "    netD = Discriminator().to(device)\n",
    "    optG = torch.optim.Adam(netG.parameters(), lr=lr, betas=(0.5, 0.999))\n",
    "    optD = torch.optim.Adam(netD.parameters(), lr=lr, betas=(0.5, 0.999))\n",
    "    for _ in range(epochs):\n",
    "        for imgs in loader:\n",
    "            imgs = imgs.to(device)\n",
    "            train_step(netG, netD, imgs, optG, optD)\n",
    "    return netG, netD\n",
